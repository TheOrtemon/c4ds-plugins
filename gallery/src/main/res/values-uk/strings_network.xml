    <!-- Network sample — Ukrainian -->
    <string name="network_tool_name">Мережеві запити</string>
    <string name="network_desc">Виконує справжній HTTPS-запит через Ktor-клієнт, наданий хостом: інструмент прив\'язує власний HttpClient, використовує ContentNegotiation з kotlinx-serialization і мапить DTO у доменну модель за інтерфейсом репозиторію.</string>
    <string name="network_apis">HttpClient(Android), ContentNegotiation, kotlinx-serialization, CommonMapInteractor.selectedPosition, CommonLocaleSettingsInteractor</string>
    <string name="network_explainer">Отримує поточну погоду для вибраної позиції на мапі з безключового API Open-Meteo. Інструмент прив\'язує власний Ktor HttpClient у своєму модулі Kodein; усі класи Ktor надає хост — в APK нічого мережевого не пакується.</string>

