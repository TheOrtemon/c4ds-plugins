<?xml version="1.0" encoding="utf-8"?>
<!-- Model icon: entity-relationship diagram — two outlined entity boxes with header dividers, joined by an L-shaped connector line -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Frames of entity boxes; evenOdd cuts out the interior leaving a 1dp border -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="
            M1,2 H11 V11 H1 Z
            M2,3 H10 V10 H2 Z
            M13,13 H23 V22 H13 Z
            M14,14 H22 V21 H14 Z" />

    <!-- Header divider bar — top-left entity box -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M2,4.5 H10 V5.5 H2 Z" />

    <!-- Header divider bar — bottom-right entity box -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M14,15.5 H22 V16.5 H14 Z" />

    <!-- L-shaped connector: horizontal from right edge of box-1 midpoint, then vertical to top edge of box-2 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M11,6 H18.5 V13 H17.5 V7 H11 Z" />

</vector>
