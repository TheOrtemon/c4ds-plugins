<resources>
    <!-- Network sample -->
    <string name="network_tool_name">Network Requests</string>
    <string name="network_desc">Makes a real HTTPS request with the host-provided Ktor client: the tool binds its own HttpClient, uses ContentNegotiation with kotlinx-serialization, and maps the DTO to a domain model behind a repository.</string>
    <string name="network_apis">HttpClient(Android), ContentNegotiation, kotlinx-serialization, CommonMapInteractor.selectedPosition, CommonLocaleSettingsInteractor</string>
    <string name="network_explainer">Fetches current weather for the selected map position from the keyless Open-Meteo API. The tool binds its own Ktor HttpClient in its Kodein module; every Ktor class is provided by the host — nothing network-related is bundled in the APK.</string>

