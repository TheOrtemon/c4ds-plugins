<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        This module declares NO manifest components of its own (no <provider>, <service>, or
        <receiver>) — see OpenWithToolDescriptor's KDoc and docs/guides/getting-started.md for why
        a plugin must never declare its own FileProvider to open or share a file. Every dependency
        below therefore stays host-provided (`compileOnly`); nothing extra is bundled.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher">

        <meta-data
            android:name="vision.combat.c4.ds.sdk.DECLARED_TOOLS"
            android:resource="@xml/combat_tools" />

    </application>
</manifest>
